{
  "builds": [
    { "src": "api/chery_dms.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/chery_epc.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/warranty.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/login.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/db.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/wa-webhook.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/kirimdev-webhook.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/kirimdev-send.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/gas*.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/csi-proxy.js", "use": "@vercel/node", "config": { "maxDuration": 15 } },
    { "src": "api/dhl_tracking.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/notify.js", "use": "@vercel/node", "config": { "maxDuration": 10 } },
    { "src": "api/tts.js", "use": "@vercel/node", "config": { "maxDuration": 15 } },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "framework": "vite" } }
  ],
  "rewrites": [
    { "source": "/api/chery_dms", "destination": "/api/chery_dms.js" },
    { "source": "/api/chery_epc", "destination": "/api/chery_epc.js" },
    { "source": "/api/warranty", "destination": "/api/warranty.js" },
    { "source": "/api/login", "destination": "/api/login.js" },
    { "source": "/api/db", "destination": "/api/db.js" },
    { "source": "/api/wa-webhook", "destination": "/api/wa-webhook.js" },
    { "source": "/api/kirimdev-webhook", "destination": "/api/kirimdev-webhook.js" },
    { "source": "/api/kirimdev-send", "destination": "/api/kirimdev-send.js" },
    { "source": "/api/gas", "destination": "/api/gas.js" },
    { "source": "/api/gas_booking", "destination": "/api/gas_booking.js" },
    { "source": "/api/gas_cro", "destination": "/api/gas_cro.js" },
    { "source": "/api/gas_laporanwo", "destination": "/api/gas_laporanwo.js" },
    { "source": "/api/gas_revenue", "destination": "/api/gas_revenue.js" },
    { "source": "/api/gas_sparepart", "destination": "/api/gas_sparepart.js" },
    { "source": "/api/gas_users", "destination": "/api/gas_users.js" },
    { "source": "/api/csi-proxy", "destination": "/api/csi-proxy.js" },
    { "source": "/api/dhl_tracking", "destination": "/api/dhl_tracking.js" },
    { "source": "/api/notify", "destination": "/api/notify.js" },
    { "source": "/api/tts", "destination": "/api/tts.js" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
